# Yalnız 'false' yazılırsa tanılama kapanır (bkz. locationDiagnostics.ts).
# Özelliğin asıl kapısı aşağıdaki URL + anahtardır; onlar yoksa hiç istek üretilmez.
EXPO_PUBLIC_LOCATION_DIAGNOSTICS_ENABLED=true

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# İKİ İSİMDEN BİRİ yeterli; kod önce PUBLISHABLE, yoksa ANON okur.
# Yeni projelerde `sb_publishable_...` biçimindeki anahtar kullanılır ve bu
# durumda istemci Authorization başlığı GÖNDERMEZ (yalnız apikey) — eski JWT
# biçimindeki anon anahtarda ise iki başlık da gider (buildSupabasePublicHeaders).
# .env.local dosyasında şu an ANON adı kullanılıyor; ikisi de geçerlidir.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SB_PUBLISHABLE_KEY
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# NOT: Uygulamanın DAVRANIŞI (kadans, açma/kapama, test penceresi) artık burada
# DEĞİL, Supabase'deki public.app_remote_config tablosunda yönetilir.
# Bkz. supabase/manual/remote_config_reference.sql
